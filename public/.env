# =============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES — OSIS SMP Kalam Kudus Padang
# =============================================================================
# CATATAN PENTING:
# 1. File ini digunakan oleh frontend (public/index.html) untuk konfigurasi
#    URL API utama. JANGAN simpan secret/rahasia di file ini karena akan
#    terekspos ke browser publik.
# 2. Secret (SMTP, GITHUB_TOKEN, JWT_SECRET) harus disimpan di environment
#    variable platform hosting (Vercel Dashboard / Cloudflare Workers Secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# URL API UTAMA
# -----------------------------------------------------------------------------
# Gunakan nilai ini untuk mengarahkan frontend ke endpoint API.
# - Saat development lokal: http://localhost:3000/api
# - Saat production Vercel: https://<nama-proyek>.vercel.app/api
# - Saat production Cloudflare: https://<nama-worker>.workers.dev/api
# Jika kosong, frontend akan otomatis memakai '/api' (relative path).
API_BASE_URL=/api

# -----------------------------------------------------------------------------
# KONFIGURASI SMTP EMAIL (Gunakan Gmail App Password)
# -----------------------------------------------------------------------------
# CATATAN: Jangan simpan nilai asli di file ini untuk production.
# Gunakan Vercel Environment Variables atau Cloudflare Workers Secrets.
