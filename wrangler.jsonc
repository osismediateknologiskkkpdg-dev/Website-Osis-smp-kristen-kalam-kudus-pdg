{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website-osis-smp-kristen-kalam-kudus-pdg",
  "main": "api/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "osis.kalamkuduspadang.sch.id/*",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OTP_STORE",
      "id": "GANTI_DENGAN_KV_NAMESPACE_ID_ANDA"
    }
  ],
  "vars": {
    "API_BASE_URL": "/api"
  }
}